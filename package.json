{
  "name": "@pentestattacker007/bughunt",
  "version": "0.1.0",
  "description": "Security-testing methodology CLI + skills for AI agents (recon, app analysis, AI-assist, PortSwigger). Defensive, authorized-use knowledge layer.",
  "type": "module",
  "bin": {
    "bughunt": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "skills",
    ".claude-plugin",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "security",
    "bug-bounty",
    "pentest",
    "recon",
    "methodology",
    "agent-skills",
    "ai-agent",
    "cli"
  ],
  "author": "fahad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pentestattacker007/bughunt.git"
  },
  "homepage": "https://github.com/pentestattacker007/bughunt#readme",
  "bugs": {
    "url": "https://github.com/pentestattacker007/bughunt/issues"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
